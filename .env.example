# Copy this file, rename the copy to ".env", and fill in your own values.
# The .env file stays on your computer and is never uploaded to GitHub.

# The Neon database address. Paste the whole line that starts with postgresql://
DATABASE_URL=

# Your teacher password (optional on your own computer, recommended online)
TEACHER_PASSWORD=

# A word students must type to make an account (optional)
CLASS_CODE=
